{
  "info": {
    "name": "PulpeStock Web — Trabajo 12 (REST Go)",
    "description": "Colección manual de demostración. Configurar credenciales solo localmente. No equivale a prueba ejecutada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5173"
    },
    {
      "key": "email",
      "value": "admin@ejemplo.com"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": "arroz-faisan-1lb"
    },
    {
      "key": "saleId",
      "value": "1"
    },
    {
      "key": "requestId",
      "value": "CAMBIAR-POR-UUID-NUEVO"
    }
  ],
  "item": [
    {
      "name": "01 Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('Go activo',()=>pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login y guardar token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));if(pm.response.code===200){pm.collectionVariables.set('csrfToken',pm.response.json().csrfToken);}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Sesión actual",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Usuario autenticado',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Catálogo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Catálogo array',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()).to.be.an('array')});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Crear producto demo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"postman-demo-001\",\n  \"nombre\": \"Producto Postman\",\n  \"categoria\": \"abarrotes\",\n  \"precioVenta\": 15,\n  \"stockActual\": 5,\n  \"stockMinimo\": 2,\n  \"codigoBarras\": \"\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Creado (o conflicto si existe)',()=>pm.expect([201,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Modificar ficha",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos/postman-demo-001",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "postman-demo-001"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Producto Postman Editado\",\n  \"categoria\": \"abarrotes\",\n  \"precioVenta\": 16,\n  \"stockMinimo\": 2,\n  \"codigoBarras\": \"\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Editado',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Movimientos — consulta",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movimientos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movimientos"
          ]
        }
      }
    },
    {
      "name": "08 Entrada de stock",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/movimientos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movimientos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"postman-demo-001\",\n  \"type\": \"entrada\",\n  \"quantity\": 2\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Movimiento creado',()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Venta transaccional (cambiar requestId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/ventas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ventas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"cashReceived\": 100,\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Venta creada o recuperada',()=>pm.expect([200,201]).to.include(pm.response.code));if([200,201].includes(pm.response.code)){pm.collectionVariables.set('saleId',pm.response.json().id);}"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Historial ventas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ventas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ventas"
          ]
        }
      }
    },
    {
      "name": "11 Detalle ticket",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ventas/{{saleId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ventas",
            "{{saleId}}"
          ]
        }
      }
    },
    {
      "name": "12 Reporte admin",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reportes/resumen",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reportes",
            "resumen"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reporte JSON',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Baja lógica del producto demo",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos/postman-demo-001",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "postman-demo-001"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Desactivado',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Cerrar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sesión terminada',()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
